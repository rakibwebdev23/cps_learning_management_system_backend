{
  "kind": "collectionType",
  "collectionName": "courses",
  "info": {
    "singularName": "course",
    "pluralName": "courses",
    "displayName": "Course",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "shortDescription": {
      "type": "text"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "level": {
      "type": "enumeration",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ],
      "default": "beginner"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "published"
    },
    "price": {
      "type": "decimal"
    },
    "discountPrice": {
      "type": "decimal"
    },
    "rating": {
      "type": "decimal",
      "default": 4.5
    },
    "reviewCount": {
      "type": "integer",
      "default": 0
    },
    "studentCount": {
      "type": "integer",
      "default": 0
    },
    "durationMinutes": {
      "type": "integer",
      "default": 0
    },
    "tags": {
      "type": "json"
    },
    "requirements": {
      "type": "json"
    },
    "learningOutcomes": {
      "type": "json"
    },
    "content_manager": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "lessons": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::lesson.lesson",
      "mappedBy": "course"
    },
    "enrollments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::enrollment.enrollment",
      "mappedBy": "course"
    },
    "lesson_progresses": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::lesson-progress.lesson-progress",
      "mappedBy": "course"
    },
    "quizzes": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::quiz.quiz",
      "mappedBy": "course_id"
    },
    "instructor": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    }
  }
}
